# Copy to .env and fill in. .env itself is never committed.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=voice_todo_app
DB_PASSWORD=
DB_NAME=voice_todo
PORT=3004

# Signs the login cookie. Any long random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# The system mailbox sign-up and forgot-password one-time passwords are sent
# from — a Google account. SMTP_PASSWORD is its 16-letter Google App Password
# (not the account's normal password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
# Name and address shown as the sender, e.g. "Voice Todo <you@gmail.com>"
SMTP_FROM=

# Optional: the address people open the app at, e.g. https://todo.example.com
# — adds a sign-in link to one-time password mails.
APP_URL=
